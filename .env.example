# RetailMind AI — environment contract (DevOps design §3)
#
# Copy to .env for local dev. NEVER commit .env.
#
# `scripts/check_env.py` holds this file to the code in both directions:
# a variable the code reads and this file omits is a production deployment
# silently inheriting a development default; a variable listed here that
# nothing reads is documentation that costs somebody an afternoon. CI runs it.
#
# **Secrets do not belong in this file, and in production they do not belong
# in the environment either.** Use the `*_FILE` convention: the platform
# mounts the secret and the application reads the path. A value in
# `environment:` is visible to `docker inspect`, appears in `ps`, and is
# inherited by every child process. See infra/secrets/README.md.

# ── App ───────────────────────────────────────────────
RM_APP_ENV=dev                    # dev | staging | prod
RM_APP_LOG_LEVEL=INFO             # DEBUG allowed in dev only
RM_APP_BASE_URL=http://localhost:8090
RM_APP_VERSION=local              # injected with the git SHA in CI builds

# ── Sizing (read by the container entrypoint) ─────────
RM_API_WORKERS=2                  # uvicorn workers; 4 is a sensible prod start
RM_WORKER_CONCURRENCY=2           # celery worker processes
# RM_API_PORT=8090                # host port the API publishes on (compose)
# RM_UI_PORT=8501                 # host port the console publishes on (compose)

# ── Postgres (app OLTP) ───────────────────────────────
RM_DB_HOST=postgres
RM_DB_PORT=5432
RM_DB_NAME=retailmind_app
RM_DB_USER=api_rw
RM_DB_PASSWORD=dev-only-password  # prod: RM_DB_PASSWORD_FILE=/run/secrets/db_password
RM_DB_POOL_SIZE=10
# `disable` is a development default and the wrong answer everywhere else.
# The production overlay sets `require`.
RM_DB_SSLMODE=disable

# ── Redis (two instances — cache vs durable state) ────
RM_REDIS_CACHE_URL=redis://redis-cache:6379/0
RM_REDIS_STATE_URL=redis://redis-state:6379/0
RM_REDIS_TTL_SECONDS=86400        # analytics cache entries; snapshot-scoped anyway

# ── Warehouse ─────────────────────────────────────────
RM_WAREHOUSE_PROFILE=duckdb       # duckdb | snowflake
RM_WAREHOUSE_DUCKDB_PATH=/data/warehouse/retailmind.duckdb
RM_WAREHOUSE_CORE_SCHEMA=analytics_analytics
RM_WAREHOUSE_SEMANTIC_SCHEMA=analytics_semantic

# ── ETL ───────────────────────────────────────────────
RM_ETL_WAREHOUSE_PATH=.local/retailmind.duckdb
RM_ETL_LANDING_ROOT=.local/lake     # bronze partitions
RM_ETL_INBOX_ROOT=.local/inbox      # where source files arrive
RM_ETL_BASE_CURRENCY=USD
RM_ETL_FX_CARRY_FORWARD_DAYS=3      # how long a stale rate may be reused
RM_ETL_LATE_ARRIVAL_WINDOW_DAYS=7   # a file older than this relands as a correction
RM_ETL_REJECT_RATE_THRESHOLD=0.02   # above this a batch is quarantined whole
RM_ETL_VOLUME_BAND_TOLERANCE=0.4    # row-count deviation that trips a volume check
RM_ETL_MAX_RETRIES=3
RM_ETL_RETRY_BASE_SECONDS=2

# ── Auth ──────────────────────────────────────────────
RM_AUTH_JWT_ISS=retailmind
RM_AUTH_JWT_AUD=retailmind-app
RM_AUTH_ACCESS_TTL_MINUTES=15     # note: _MINUTES, not _MIN — the model's field name
RM_AUTH_REFRESH_TTL_DAYS=30
RM_AUTH_REFRESH_COOKIE_NAME=rm_refresh
RM_AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# False only because local dev is plain HTTP. Any deployment reachable over
# TLS must set this true, or the refresh cookie travels in clear text.
RM_AUTH_COOKIE_SECURE=false
# The signing key. In-line PEM is for local dev only; production mounts it.
RM_AUTH_JWT_PRIVATE_KEY_PEM=
# prod: RM_AUTH_JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key

# ── Workers ───────────────────────────────────────────
# Durable Redis, not the cache: a broker on an LRU-evicting instance drops
# queued tasks under memory pressure and nothing reports it.
RM_CELERY_BROKER_URL=redis://redis-state:6379/1
RM_CELERY_RESULT_BACKEND=redis://redis-state:6379/2

# ── Tenancy ───────────────────────────────────────────
# Scheduled work has no request to derive a tenant from, so the beat schedule
# runs against this one.
RM_DEFAULT_TENANT_ID=

# ── Mail ──────────────────────────────────────────────
# Unset RM_SMTP_HOST and the platform uses a null sender. That default is
# deliberate: a worker that quietly acquires a live SMTP connection because a
# variable happened to be set is how a developer's laptop mails a customer.
RM_SMTP_HOST=
RM_SMTP_PORT=587
RM_SMTP_USERNAME=
RM_SMTP_SENDER=alerts@retailmind.local
RM_SMTP_PASSWORD=                 # dev only; prod uses the _FILE form below
# prod: RM_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# ── Edge and TLS (production) ─────────────────────────
# The edge publishes 80/443 by default and should keep them. Override only on
# a host already running something there (a shared box, a staging VM behind
# another load balancer).
# RM_HTTP_PORT=80
# RM_HTTPS_PORT=443
# RM_DOMAIN=retailmind.example.com
# RM_ACME_EMAIL=ops@example.com     # Let's Encrypt expiry notices
# RM_GRAFANA_URL=http://localhost:3000

# ── Console ───────────────────────────────────────────
RM_API_BASE_URL=http://api:8000   # in-cluster; the browser goes through the edge

# ── Not yet wired ─────────────────────────────────────
#
# Documented ahead of the code that will read them, and grouped here so nobody
# sets one expecting an effect. `scripts/check_env.py` allows unread variables
# only below this heading — which is the point: the list cannot rot silently,
# because moving one above the line makes CI demand that something reads it.

# Object store — the ETL writes to the local filesystem today (S3 in S4).
# RM_S3_ENDPOINT=http://minio:9000
# RM_S3_BUCKET_BRONZE=rm-bronze
# RM_S3_BUCKET_ARTIFACTS=rm-artifacts
# RM_S3_ACCESS_KEY=minioadmin
# RM_S3_SECRET_KEY=minioadmin

# LLM gateway — narration is templated today; no model is called.
# RM_LLM_MOCK=1
# RM_LLM_MODEL_DEFAULT=
# RM_LLM_MODEL_CHEAP=
# RM_LLM_TIMEOUT_S=30
# RM_LLM_API_KEY_FILE=/run/secrets/llm_api_key

# Tracing and error reporting — metrics and structured logs ship today.
# RM_OBS_OTEL_ENDPOINT=
# RM_OBS_SENTRY_DSN=
# RM_OBS_TRACE_SAMPLE_RATE=0.1

# Snowflake warehouse profile — DuckDB is the only implemented profile.
# RM_WAREHOUSE_SNOWFLAKE_ACCOUNT=
# RM_WAREHOUSE_SNOWFLAKE_KEY_FILE=/run/secrets/snowflake_key

# Slack notifications — email and in-app are implemented.
# RM_SLACK_WEBHOOK_FILE=/run/secrets/slack_webhook
