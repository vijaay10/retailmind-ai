# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ── Node / frontend ───────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo

# ── Environment & secrets (never commit; gitleaks enforces) ──
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# The mount target has to exist in a fresh clone, and the instructions for
# filling it have to ship with it — `secrets/` above hid both, so a clone had
# no directory and no way to learn what belongs in it. Git will not descend
# into an ignored directory, so the directory is re-included first and its
# contents excluded again; only the two documentation files come back.
!infra/secrets/
infra/secrets/*
!infra/secrets/.gitignore
!infra/secrets/README.md

# ── Data (fixtures/seeds in-repo are the ONLY data in git) ──
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3
data/
bronze/
*.parquet
!data_platform/tests/fixtures/**/*.parquet
!backend/tests/fixtures/**/*.parquet

# ── dbt ───────────────────────────────────────────────
data_platform/dbt/target/
data_platform/dbt/dbt_packages/
data_platform/dbt/logs/
# NOT ignored: data_platform/dbt/profiles.yml
# Ignoring a dbt profile is the right default when it holds warehouse
# credentials. This one holds none — the path comes from
# env_var('RM_WAREHOUSE_DUCKDB_PATH') with a relative fallback, and the rest
# is thread count and a timezone. Ignored, it never reached a clone, so
# `make demo`, `make warehouse` and the dbt integration tests all failed on
# any machine but the one that wrote it.

# ── Airflow ───────────────────────────────────────────
airflow-webserver.pid
data_platform/orchestration/logs/

# ── Dagster (local dev instance home — run history, schedule state) ───
# `dagster dev` writes its SQLite run/event-log/schedule state under
# whatever DAGSTER_HOME resolves to at the time — a bare `.dagster_home/`
# (the base_dir in orchestration/dagster.yaml) normally, but pytest/adhoc
# runs (`tempfile.mkdtemp`) have produced `.tmp_dagster_home_*` siblings
# that `*.db` alone doesn't fully cover (lock files, event log dirs
# alongside the .db files). Prompt 14 found 18MB of these sitting
# untracked-but-not-ignored — a `git add -A` would have staged them.
.dagster_home/
data_platform/.tmp_dagster_home*/

# ── ML artifacts (MLflow/S3 own binaries, git owns code) ──
mlruns/
*.pkl
*.joblib
ml/notebooks/**/*.ipynb_checkpoints/

# ── Terraform ─────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# ── IDE / OS ──────────────────────────────────────────
.idea/
# The shared VS Code setup is part of the project — a workspace configuration
# nobody receives is a workspace configuration nobody has. Personal files
# (launch overrides, per-user state) stay ignored by the wildcard.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.DS_Store

# ── Logs & local scratch ──────────────────────────────
*.log
tmp/
.local/
