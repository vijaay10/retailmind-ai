# RetailMind AI — environment contract (DevOps design §3)
# Copy to .env for local dev. NEVER commit .env. Secrets use *_FILE variants
# (Docker secrets) or a managed store in cloud — plaintext values below are
# dev-only defaults. CI checks this file against the settings model for drift.

# ── App ───────────────────────────────────────────────
RM_APP_ENV=dev                    # dev | staging | prod
RM_APP_LOG_LEVEL=INFO             # DEBUG allowed in dev only
RM_APP_BASE_URL=http://localhost:8080
RM_APP_VERSION=local              # injected with git SHA in CI builds

# ── Postgres (app OLTP) ───────────────────────────────
RM_DB_HOST=postgres
RM_DB_PORT=5432
RM_DB_NAME=retailmind_app
RM_DB_USER=api_rw
RM_DB_PASSWORD=dev-only-password  # prod: RM_DB_PASSWORD_FILE=/run/secrets/db_password
RM_DB_POOL_SIZE=10
RM_DB_SSLMODE=disable             # prod: require

# ── Redis (two instances — cache vs durable state) ────
RM_REDIS_CACHE_URL=redis://redis-cache:6379/0
RM_REDIS_STATE_URL=redis://redis-state:6379/0

# ── Warehouse ─────────────────────────────────────────
RM_WAREHOUSE_PROFILE=duckdb       # duckdb | snowflake
RM_WAREHOUSE_DUCKDB_PATH=/data/warehouse/retailmind.duckdb
# RM_WAREHOUSE_SNOWFLAKE_ACCOUNT=
# RM_WAREHOUSE_SNOWFLAKE_KEY_FILE=/run/secrets/snowflake_key

# ── Object store (bronze, artifacts, reports) ─────────
RM_S3_ENDPOINT=http://minio:9000  # empty for real AWS S3
RM_S3_BUCKET_BRONZE=rm-bronze
RM_S3_BUCKET_ARTIFACTS=rm-artifacts
RM_S3_ACCESS_KEY=minioadmin       # dev only
RM_S3_SECRET_KEY=minioadmin       # dev only

# ── Auth ──────────────────────────────────────────────
RM_AUTH_JWT_ISS=retailmind
RM_AUTH_JWT_AUD=retailmind-app
RM_AUTH_ACCESS_TTL_MIN=15
RM_AUTH_REFRESH_TTL_DAYS=14
# RM_AUTH_JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_signing_key

# ── LLM (Claude via the gateway — the ONLY module that reads these) ──
RM_LLM_MODEL_DEFAULT=claude-sonnet-5
RM_LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
RM_LLM_TIMEOUT_S=20
RM_LLM_MOCK=true                  # dev default: no live LLM calls, no key needed
# RM_LLM_API_KEY_FILE=/run/secrets/anthropic_api_key

# ── Notifications ─────────────────────────────────────
RM_SMTP_HOST=mailpit              # dev SMTP catcher (compose.dev)
RM_SMTP_PORT=1025
# RM_SLACK_WEBHOOK_FILE=/run/secrets/slack_webhook

# ── Observability ─────────────────────────────────────
RM_OBS_OTEL_ENDPOINT=             # empty = disabled
RM_OBS_SENTRY_DSN=                # empty = disabled
RM_OBS_TRACE_SAMPLE_RATE=0.1
